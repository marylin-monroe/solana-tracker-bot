{
  "name": "solana-smart-money-tracker-bot",
  "version": "3.0.0",
  "description": "Advanced Telegram bot with real-time QuickNode and Alchemy APIs for tracking smart money and monitoring large transactions on Solana. Features Dragon project integration, multi-provider failover, and comprehensive scam filtering.",
  "main": "dist/main.js",
  "scripts": {
    "build": "npm rebuild better-sqlite3 && tsc",
    "start": "node --max-old-space-size=768 --expose-gc dist/main.js",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "clean": "rm -rf dist",
    "rebuild": "npm run clean && npm run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "solana", "telegram", "bot", "smart-money", "crypto", "trading",
    "blockchain", "quicknode", "alchemy", "jupiter", "dragon",
    "large-transactions", "monitoring"
  ],
  "author": "Smart Money Bot Team",
  "license": "MIT",
  "dependencies": {
    "@solana/spl-token": "^0.1.8",
    "@solana/web3.js": "^1.91.0",
    "axios": "^1.6.8",
    "better-sqlite3": "^9.4.3",
    "body-parser": "^1.20.2",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "node-cron": "^3.0.3",
    "node-telegram-bot-api": "^0.66.0",
    "sqlite3": "^5.1.7",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.9",
    "@types/body-parser": "^1.19.2",
    "@types/express": "^4.17.17",
    "@types/node": "^20.12.0",
    "@types/node-cron": "^3.0.11",
    "@types/node-telegram-bot-api": "^0.64.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": "20.x"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marylin-monroe/solana-smart-money-tracker.git"
  },
  "bugs": {
    "url": "https://github.com/marylin-monroe/solana-smart-money-tracker/issues"
  },
  "homepage": "https://github.com/marylin-monroe/solana-smart-money-tracker#readme"
}